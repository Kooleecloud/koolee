# A SAMPLE, for demonstrating `pnpm env:verify`. Not a real environment, and
# not one to copy: every value below is the literal word "set".
#
#   pnpm env:verify --app web --file docs/launch/env-sample-production.env --live --push
#
# The names are what matter. `env:verify` reads names and never values, so a
# file like this proves the manifest and the checker agree without any secret
# existing anywhere. Real values live in Vercel and nowhere else.

DATABASE_URL=set
OTP_LOG_HMAC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef
NEXT_PUBLIC_SUPABASE_URL=set
NEXT_PUBLIC_SUPABASE_ANON_KEY=set
SUPABASE_SERVICE_ROLE_KEY=set
NEXT_PUBLIC_TURNSTILE_SITE_KEY=set
RESEND_API_KEY=set
RESEND_FROM=set
OPS_ALERT_EMAIL=set
ANTHROPIC_API_KEY=set
STRIPE_SECRET_KEY=set
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=set
STRIPE_WEBHOOK_SECRET=set
CRON_SECRET=set
NEXT_PUBLIC_APP_URL=set
NEXT_PUBLIC_AGENT_APP_URL=set
NEXT_PUBLIC_ADMIN_APP_URL=set
INNGEST_EVENT_KEY=set
INNGEST_SIGNING_KEY=set
GOOGLE_MAPS_SERVER_KEY=set
NEXT_PUBLIC_SENTRY_DSN=set
SENTRY_ORG=set
SENTRY_PROJECT=set
SENTRY_AUTH_TOKEN=set
ASSIGNMENT_HORIZON_HOURS=48
VAPID_PUBLIC_KEY=set
VAPID_PRIVATE_KEY=set
VAPID_SUBJECT=mailto:ops@koolee.cloud
NEXT_PUBLIC_VAPID_PUBLIC_KEY=set
