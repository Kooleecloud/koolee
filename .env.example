# ---------------------------------------------------------------------------
# Koolee — root environment template.
#
# Copy to `.env.local` and fill in what you need. EVERY value here is optional
# at boot: `pnpm install && pnpm build && pnpm lint && pnpm typecheck && pnpm test`
# all pass with this file untouched and no .env.local at all.
#
# A variable only becomes required when a code path that genuinely needs it
# runs, and the error names the variable and where to get it.
#
# Full reference — every var, which app reads it, what breaks without it, and
# the boot gates: docs/ENVIRONMENT.md
#
# NOTE: Next.js does NOT read this directory's .env.local — each app reads only
# its own apps/<app>/.env.local. This file is the canonical reference for where
# every key comes from; copy the per-app .env.example files to make values live.
# ---------------------------------------------------------------------------

# --- App --------------------------------------------------------------------
# Each app's own origin, so this is set per app, not shared:
#   apps/web   → http://localhost:3000
#   apps/agent → http://localhost:3001
#   apps/admin → http://localhost:3002
# NEXT_PUBLIC_APP_URL=

# apps/admin ONLY. Agent invite links are issued from admin and must land on
# the AGENT app; without this they go to the wrong one. In admin's production
# boot gate for that reason.
# NEXT_PUBLIC_AGENT_APP_URL=http://localhost:3001

# --- Database ---------------------------------------------------------------
# Runtime queries. Supabase → Settings → Database → Connection pooling,
# TRANSACTION mode, port 6543. `prepare: false` is applied for you.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Migrations and DDL only. Supabase → Settings → Database → Direct connection,
# port 5432. Never point this at the pooler.
DIRECT_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Local Postgres instead (docker compose up -d):
# DATABASE_URL=postgres://koolee:koolee@localhost:5433/koolee
# DIRECT_DATABASE_URL=postgres://koolee:koolee@localhost:5433/koolee

# --- Supabase (client SDK: Realtime + Storage only) --------------------------
# Server-side reads go through Drizzle and BYPASS RLS. These keys exist for the
# browser: the live custody timeline and bag-photo uploads.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi_your_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi_your_service_role_key

# --- Auth hardening (apps/web) -----------------------------------------------
# ALL FOUR are required in production: apps/web asserts them at boot
# (assertProductionSecurityConfig) because each one, absent, silently DISABLES
# a control rather than erroring. See docs/ENVIRONMENT.md §4.

# Cloudflare → Turnstile → your site → Site key (invisible mode).
# The SECRET key goes in the Supabase dashboard (Auth → Attack Protection);
# Supabase verifies the token we forward, so this app never calls siteverify.
# Absent → no widget mounts → CAPTCHA is off across the whole funnel.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# HMAC key for otp_send_log.destination_hash — the OTP throttle stores hashes,
# never plaintext phones/emails. Generate: `openssl rand -hex 32` (min 32
# chars). VALIDATED AT IMPORT whenever DATABASE_URL is set. Rotating it resets
# rate-limit windows, which is harmless.
OTP_LOG_HMAC_KEY=

# Set "false" ONLY for a bare local Postgres with no GoTrue `auth` schema.
# Leave UNSET against any Supabase project: unset counts as available, so a
# genuinely missing schema fails the send loudly instead of silently skipping
# claim reconciliation.
# AUTH_SCHEMA_AVAILABLE=

# Shared secret protecting the manual job routes (/api/jobs/*). Any random
# string. The routes REFUSE to run without it, so they can never be triggered
# anonymously in production.
CRON_SECRET=

# --- Payments ----------------------------------------------------------------
# Absent → the booking flow uses FakePaymentProvider and no money moves.
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_from_stripe_listen_or_dashboard
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# --- Background jobs ---------------------------------------------------------
# Neither is needed for `pnpm dev:inngest` against the local dev server.
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=signkey-prod-your_signing_key

# --- Notifications (interfaces + console fallback; not integrated) -----------
# Auth OTP SMS credentials live in the Supabase dashboard, never in app env.
# Custody-event SMS credentials land with the notifications work item.
RESEND_API_KEY=re_your_api_key

# --- Third-party data (stubbed) ----------------------------------------------
AEROAPI_KEY=your_flightaware_aeroapi_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
ANTHROPIC_API_KEY=sk-ant-your_api_key

# --- Observability -----------------------------------------------------------
SENTRY_DSN=https://your_key@o0.ingest.sentry.io/0

# --- Tests -------------------------------------------------------------------
# Opt-in. Set this and the integration tests run against it; leave it unset and
# they skip. Point it at a THROWAWAY database — the suite migrates and truncates.
# TEST_DATABASE_URL=postgres://koolee:koolee@localhost:5433/koolee
