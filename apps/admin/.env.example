# apps/admin — ops console. Port 3002.
#
# Copy to `.env.local` and fill in only what you need. Every key is left EMPTY
# on purpose: `cp .env.example .env.local` must leave the app booting green and
# degrading to the fallbacks documented below. A realistic shape for each value
# is shown in the comment above it — see README.md for the table.
#
# Least privilege: this app holds a Stripe secret key (refunds are issued from
# the console) but no webhook secret, no publishable key, and no notification
# or third-party data credentials.
#
# Next.js reads .env.local from THIS directory — a repo-root .env.local is not
# picked up by the app.

# --- App ---------------------------------------------------------------------
# This app's own origin. Used for absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Origin of the AGENT app — agent invite links from /staff must land there.
# Absent → defaults to http://localhost:3001. A PRODUCTION boot refuses to
# start without it (src/env.ts): a defaulted localhost invite link is broken.
#   NEXT_PUBLIC_AGENT_APP_URL=https://agent.your-domain.com
NEXT_PUBLIC_AGENT_APP_URL=

# --- Supabase (Settings → API) -----------------------------------------------
# Required for admin sign-in and live-updating ops views. A PRODUCTION boot
# refuses to start without URL + anon key + service-role key (src/env.ts) —
# each, absent, silently disables sign-in, staff invites, or evidence-photo
# signed URLs.
#   NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi_your_anon_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role bypasses RLS. Server-side only — never expose to the browser.
# Used for staff invites (inviteUserByEmail) and evidence-photo signed URLs.
#   SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi_your_service_role_key
SUPABASE_SERVICE_ROLE_KEY=

# --- Bot protection (Cloudflare → Turnstile) ----------------------------------
# SITE key only. The SECRET lives in the Supabase dashboard (Auth → Attack
# Protection) and is a single per-PROJECT value — so this must be the SAME site
# key apps/web uses for this environment, or siteverify rejects the token.
#
# Required whenever the Supabase project has CAPTCHA protection ON. That is a
# project-wide setting, so enabling it for the customer funnel also gates this
# app's sign-in (`/token?grant_type=password`) and password reset (`/recover`).
# Absent then → both fail with
#   "captcha protection: request disallowed (no captcha_token found)"
# Absent with CAPTCHA off → the widget never renders and nothing changes.
# Cloudflare's always-pass TEST site key for local dev:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB   (invisible, passes)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Database (Supabase → Connect → Database) --------------------------------
# Required for all DB access. Absent → the bookings table renders empty.
# A malformed value is WORSE than an empty one: it gets past validation and
# fails at connect time.
# Pooled, TRANSACTION mode, port 6543. Runtime queries.
#   DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
#   (local: postgres://koolee:koolee@localhost:5433/koolee — docker compose up -d)
DATABASE_URL=
# DIRECT_DATABASE_URL is deliberately ABSENT here. Nothing in this app reads
# it — the runtime uses DATABASE_URL (pooled, 6543) — and it is a hosted DDL
# credential sitting one `dotenv -e` away from the migrator. It belongs in
# packages/db/.env and nowhere else.

# --- Stripe (Developers → API keys; test mode) -------------------------------
# Optional but needed to issue real refunds from the console.
# Absent → refund actions use FakePaymentProvider and no money moves.
#   STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_SECRET_KEY=

# --- Inngest (Cloud → Events) ------------------------------------------------
# Optional. This app only SENDS domain events (an ops override moving a
# booking to exception); the function registry and INNGEST_SIGNING_KEY live in
# apps/web. Unset is fine locally — `pnpm dev:inngest` accepts unauthenticated
# sends.
#   INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_EVENT_KEY=

# --- Monitoring --------------------------------------------------------------
# Optional: absent → errors log to console.
# Sentry → Project Settings → Client Keys (DSN).
#   SENTRY_DSN=https://your_key@o0.ingest.sentry.io/0
SENTRY_DSN=
