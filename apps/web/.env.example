# apps/web — public site, booking flow, customer dashboard. Port 3000.
#
# Copy to `.env.local` and fill in only what you need. Every key is left EMPTY
# on purpose: `cp .env.example .env.local` must leave the app booting green and
# degrading to the fallbacks documented below. A realistic shape for each value
# is shown in the comment above it — see the repo-root .env.example for the
# full reference and README.md for the table.
#
# A variable becomes required only when a code path that genuinely needs it
# runs, and the error names the variable and where to get it (src/env.ts).
#
# Next.js reads .env.local from THIS directory. A repo-root .env.local is NOT
# picked up by the app — only drizzle-kit falls back to the root.

# --- App ---------------------------------------------------------------------
# This app's own origin. Used for absolute links and Stripe return URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pre-launch switch. "coming_soon" keeps the marketing site and booking funnel
# browsable but closes every account surface: /login, /trips and /dashboard
# redirect home, the funnel's verify step shows a coming-soon panel, and the
# OTP server actions refuse to send. Unset (or "live") means fully live.
# NEXT_PUBLIC_LAUNCH_MODE=coming_soon

# --- Supabase (Settings → API) -----------------------------------------------
# Required for the browser-side features only: the live custody timeline and
# storage reads. Server-side reads go through Drizzle and BYPASS RLS.
# Absent → the timeline falls back to a server fetch with no live updates.
#   NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi_your_anon_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role bypasses RLS. Server-side only — never expose to the browser.
#   SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi_your_service_role_key
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Supabase → Connect → Database) --------------------------------
# Required for all DB access. Absent → read paths render an empty state and
# mutation paths throw MissingEnvError. A malformed value is WORSE than an
# empty one: it gets past validation and fails at connect time.
# Pooled, TRANSACTION mode, port 6543. Runtime queries; `prepare: false` is
# applied for you.
#   DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
#   (local: postgres://koolee:koolee@localhost:5433/koolee — docker compose up -d)
DATABASE_URL=
# DIRECT_DATABASE_URL is deliberately ABSENT here. Nothing in this app reads
# it — the runtime uses DATABASE_URL (pooled, 6543) — and it is a hosted DDL
# credential sitting one `dotenv -e` away from the migrator. It belongs in
# packages/db/.env and nowhere else.

# --- Stripe (Developers → API keys; test mode) -------------------------------
# Optional: with NEITHER key set, checkout uses FakePaymentProvider and no
# money moves. Real card collection (the Payment Element) needs BOTH keys —
# a secret key WITHOUT a publishable key makes the pay step refuse loudly,
# since the runtime would authorize against Stripe but the browser could
# never confirm.
#   STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_SECRET_KEY=
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`,
# or Developers → Webhooks for a deployed endpoint. Required in production;
# locally optional — without it the return page's server-side status re-check
# advances paid bookings and the webhook route rejects everything.
#   STRIPE_WEBHOOK_SECRET=whsec_from_stripe_listen_or_dashboard
STRIPE_WEBHOOK_SECRET=

# --- Inngest (Cloud → Events / Deploy) ---------------------------------------
# Optional locally: `pnpm dev:inngest` runs the dev server and needs no keys.
# Required in production.
#   INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_EVENT_KEY=
#   INNGEST_SIGNING_KEY=signkey-prod-your_signing_key
INNGEST_SIGNING_KEY=

# --- Notifications -----------------------------------------------------------
# Auth OTP SMS is delivered by Supabase Auth: its provider credentials live in
# the Supabase dashboard (Auth → Providers → Phone), NEVER in app env.
# Custody-event SMS credentials land with the notifications work item — until
# then the NotificationDispatcher stub logs to console and needs no keys.
# Resend → API Keys. Optional locally: absent → Notifier logs to console.
# REQUIRED IN PRODUCTION — the boot gate in src/env.ts refuses to start a live
# prod deploy without it, because degrading to console means confirmations
# vanish into a log nobody reads.
#   RESEND_API_KEY=re_your_api_key
RESEND_API_KEY=
# RFC 5322 From for transactional mail. Defaults to Resend's SANDBOX sender
# (`Koolee <onboarding@resend.dev>`), which only delivers to your own Resend
# account address. Set this to the verified domain once its DKIM/SPF records
# are live, or real customers never receive a confirmation.
#   RESEND_FROM=Koolee <notify@koolee.cloud>
RESEND_FROM=
# Ops inbox for `booking/exception_raised` alert emails. Optional locally.
# REQUIRED IN PRODUCTION, same gate and the same reason: unset, the alert
# function logs "OPS_ALERT_EMAIL not configured; skipping" and returns, so
# every exception alert is dropped while the deploy looks healthy.
#   OPS_ALERT_EMAIL=ops@koolee.cloud
OPS_ALERT_EMAIL=

# --- External APIs -----------------------------------------------------------
# All optional: absent → the feature is stubbed, never a crash.
# FlightAware AeroAPI → My Account → API keys. Flight lookup is stubbed.
#   AEROAPI_KEY=your_flightaware_aeroapi_key
AEROAPI_KEY=
# Google Cloud Console → Maps Platform. Drive time uses a fixed estimate.
#   GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_MAPS_API_KEY=
# console.anthropic.com → API keys. Switches ticket-PDF extraction to Claude;
# absent → the free in-process heuristic extractor runs instead.
#   ANTHROPIC_API_KEY=sk-ant-your_api_key
ANTHROPIC_API_KEY=
# Debug aid: returns the RAW extraction diagnostics to the browser and renders
# them under the upload card — every segment the model read, which leg was
# chosen and why, both attempts with token usage. The payload contains the
# customer's itinerary, so set this locally or on a preview deployment only,
# NEVER on production.
#   TICKET_EXTRACTION_DEBUG=1
TICKET_EXTRACTION_DEBUG=

# --- Monitoring --------------------------------------------------------------
# Optional: absent → ops alerts log to console.
# Sentry → Project Settings → Client Keys (DSN).
#   SENTRY_DSN=https://your_key@o0.ingest.sentry.io/0
SENTRY_DSN=

# --- Bot protection (Cloudflare → Turnstile) ----------------------------------
# Site key ONLY — the app mints tokens in the browser and forwards them as
# `captchaToken`; Supabase Auth does the verification. The SECRET key goes in
# the Supabase dashboard (Auth → Attack Protection), never in app env.
# Absent → auth calls send no token; leave Supabase CAPTCHA protection off.
# Cloudflare's always-pass TEST site key for local dev:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB   (invisible, passes)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Auth schema declaration ----------------------------------------------------
# Set "false" ONLY when DATABASE_URL is a bare Postgres with no GoTrue `auth`
# schema (local docker compose): upgrade sends then skip claim reconciliation.
# Leave unset against any Supabase project (hosted or `supabase start`) —
# unset means available, and a genuinely missing schema fails the send loudly.
# Production refuses to boot with "false" (see src/env.ts).
AUTH_SCHEMA_AVAILABLE=

# --- Scheduled jobs ------------------------------------------------------------
# Shared secret protecting manual job triggers (POST /api/jobs/cleanup-anon).
# Any random string. Absent → the route refuses to run.
CRON_SECRET=

# --- OTP send-log hashing ------------------------------------------------------
# 32-byte random hex; rotating it resets rate-limit windows, which is harmless
# HMAC key for otp_send_log.destination_hash — the throttle stores hashes, never
# plaintext phones/emails. Required whenever DATABASE_URL is set (checked at
# boot in src/env.ts). Generate with: openssl rand -hex 32
#   OTP_LOG_HMAC_KEY=9f2c...64 hex chars
OTP_LOG_HMAC_KEY=
