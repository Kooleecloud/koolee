# apps/agent — check-in agent + driver PWA. Port 3001.
#
# Copy to `.env.local` and fill in only what you need. Every key is left EMPTY
# on purpose: `cp .env.example .env.local` must leave the app booting green and
# degrading to the fallbacks documented below. A realistic shape for each value
# is shown in the comment above it — see README.md for the table.
#
# Least privilege: no Stripe and no notification credentials here. This app
# never takes a payment, and a shared, frequently-lost device should not carry
# live payment or messaging credentials.
#
# Next.js reads .env.local from THIS directory — a repo-root .env.local is not
# picked up by the app.

# --- App ---------------------------------------------------------------------
# This app's own origin. Used for absolute links and PWA callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# --- Supabase (Settings → API) -----------------------------------------------
# Required for bag-photo uploads to Supabase Storage.
# Absent → photo capture stays local and nothing is uploaded.
#   NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi_your_anon_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role bypasses RLS. Server-side only — never expose to the browser.
#   SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi_your_service_role_key
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Supabase → Connect → Database) --------------------------------
# Required for all DB access. Absent → the task list renders an empty state.
# A malformed value is WORSE than an empty one: it gets past validation and
# fails at connect time.
# Pooled, TRANSACTION mode, port 6543. Runtime queries.
#   DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
#   (local: postgres://koolee:koolee@localhost:5433/koolee — docker compose up -d)
DATABASE_URL=
# Direct connection, port 5432. Migrations and DDL only — never the pooler.
#   DIRECT_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DIRECT_DATABASE_URL=

# --- External APIs -----------------------------------------------------------
# Optional. Google Cloud Console → Maps Platform.
# Absent → route ETA uses a fixed estimate. Stubbed in this scaffold.
#   GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_MAPS_API_KEY=

# --- Monitoring --------------------------------------------------------------
# Optional: absent → errors log to console.
# Sentry → Project Settings → Client Keys (DSN).
#   SENTRY_DSN=https://your_key@o0.ingest.sentry.io/0
SENTRY_DSN=
