# apps/agent — check-in agent + driver PWA. Port 3001.
#
# Copy to `.env.local` and fill in only what you need. Every key is left EMPTY
# on purpose: `cp .env.example .env.local` must leave the app booting green and
# degrading to the fallbacks documented below. A realistic shape for each value
# is shown in the comment above it — see README.md for the table.
#
# Least privilege: no Stripe and no notification credentials here. This app
# never takes a payment, and a shared, frequently-lost device should not carry
# live payment or messaging credentials.
#
# Next.js reads .env.local from THIS directory — a repo-root .env.local is not
# picked up by the app.

# --- App ---------------------------------------------------------------------
# This app's own origin. Used for absolute links and PWA callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# --- Supabase (Settings → API) -----------------------------------------------
# Required for staff sign-in (email/password) and bag-photo uploads.
# Absent → sign-in is unavailable; photo capture stays local. A PRODUCTION
# boot refuses to start without both values (src/env.ts) — sign-in is the
# app, so its silent absence is a misconfiguration.
# NOTE: this app deliberately holds NO service-role key — a shared,
# frequently-lost agent device must not carry credentials that bypass RLS.
#   NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi_your_anon_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Bot protection (Cloudflare → Turnstile) ----------------------------------
# SITE key only. The SECRET lives in the Supabase dashboard (Auth → Attack
# Protection) and is a single per-PROJECT value — so this must be the SAME site
# key apps/web uses for this environment, or siteverify rejects the token.
#
# Required whenever the Supabase project has CAPTCHA protection ON. That is a
# project-wide setting, so enabling it for the customer funnel also gates this
# app's sign-in (`/token?grant_type=password`) and password reset (`/recover`).
# Absent then → both fail with
#   "captcha protection: request disallowed (no captcha_token found)"
# Absent with CAPTCHA off → the widget never renders and nothing changes.
# Cloudflare's always-pass TEST site key for local dev:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB   (invisible, passes)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Database (Supabase → Connect → Database) --------------------------------
# Required for all DB access. Absent → the task list renders an empty state.
# A malformed value is WORSE than an empty one: it gets past validation and
# fails at connect time.
# Pooled, TRANSACTION mode, port 6543. Runtime queries.
#   DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
#   (local: postgres://koolee:koolee@localhost:5433/koolee — docker compose up -d)
DATABASE_URL=
# DIRECT_DATABASE_URL is deliberately ABSENT here. Nothing in this app reads
# it — the runtime uses DATABASE_URL (pooled, 6543) — and it is a hosted DDL
# credential sitting one `dotenv -e` away from the migrator. It belongs in
# packages/db/.env and nowhere else.

# --- Inngest (Cloud → Events) ------------------------------------------------
# Optional. This app only SENDS domain events (a booking raising an
# exception); the function registry and INNGEST_SIGNING_KEY live in apps/web.
# Unset is fine locally — `pnpm dev:inngest` accepts unauthenticated sends.
#   INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_EVENT_KEY=

# --- Monitoring (Sentry) -----------------------------------------------------
# All optional: with no DSN the SDK initialises disabled and nothing is sent,
# which is what every local run does.
#
# The DSN is NEXT_PUBLIC_ on purpose. One variable for both runtimes — a
# server-only DSN plus a public twin is two things that can disagree, and the
# failure (the browser half silently reporting nothing) is invisible. A DSN is
# not a secret; it ships in the client bundle by design.
# Sentry → Project → Settings → Client Keys (DSN). ONE PROJECT PER APP.
#   NEXT_PUBLIC_SENTRY_DSN=https://your_key@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload, BUILD TIME ONLY. All three or none: without them a build
# succeeds and stack traces in Sentry stay minified.
# SENTRY_AUTH_TOKEN is a real secret (Sentry → Settings → Auth Tokens,
# scope `project:releases`).
#   SENTRY_ORG=your-org-slug
#   SENTRY_PROJECT=koolee-agent
#   SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
