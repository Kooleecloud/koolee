{
  "name": "@koolee/driver",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild --clean",
    "tokens": "node scripts/theme-tokens.mjs",
    "icons": "node scripts/app-icons.mjs",
    "update:preview": "EXPO_NO_DOTENV=1 npx eas-cli update --channel preview --environment preview",
    "update:production": "EXPO_NO_DOTENV=1 npx eas-cli update --channel production --environment production",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .expo .turbo node_modules ios android *.tsbuildinfo"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/sora": "^0.4.2",
    "@koolee/api-contract": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@sentry/react-native": "8.28.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "aes-js": "^3.1.2",
    "base64-arraybuffer": "^1.0.2",
    "date-fns": "^4.4.0",
    "expo": "~57.0.25",
    "expo-battery": "^57.0.3",
    "expo-build-properties": "^57.0.22",
    "expo-camera": "^57.0.5",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "^57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "^57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "^57.0.20",
    "expo-image-picker": "^57.0.20",
    "expo-intent-launcher": "^57.0.1",
    "expo-keep-awake": "^57.0.2",
    "expo-linking": "~57.0.11",
    "expo-location": "^57.0.20",
    "expo-network": "~57.0.2",
    "expo-notifications": "^57.0.21",
    "expo-router": "~57.0.23",
    "expo-secure-store": "^57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "^57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "^57.0.20",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.48.0",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "*",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@koolee/config": "workspace:*",
    "@koolee/core": "workspace:*",
    "@types/aes-js": "^3.1.4",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "*",
    "eslint": "^10.8.0",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
