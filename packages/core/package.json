{
  "name": "@koolee/core",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./web-push": "./src/notifications/web-push.ts",
    "./booking": "./src/booking/index.ts",
    "./slots": "./src/slots/index.ts",
    "./pricing": "./src/pricing/index.ts",
    "./payments": "./src/payments/index.ts",
    "./extraction": "./src/extraction/index.ts",
    "./uploads": "./src/uploads/index.ts",
    "./auth": "./src/auth/index.ts",
    "./services": "./src/services/index.ts",
    "./jobs": "./src/jobs/index.ts",
    "./coverage": "./src/coverage/index.ts",
    "./observability": "./src/observability/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "push:vapid": "node scripts/generate-vapid.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:watch": "vitest",
    "test:integration": "vitest run integration.test; rc=$?; pnpm --filter @koolee/db seed:local; exit $rc",
    "clean": "rm -rf .turbo node_modules coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@date-fns/tz": "^1.2.0",
    "@koolee/db": "workspace:*",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "inngest": "^4.14.0",
    "stripe": "^22.4.0",
    "unpdf": "^1.8.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@koolee/config": "workspace:*",
    "@supabase/supabase-js": "^2.111.0",
    "@types/node": "^24.13.3",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "postgres": "^3.4.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
