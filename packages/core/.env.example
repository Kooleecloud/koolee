# @koolee/core reads NO environment variables — by design.
#
# Every credential and connection is injected by the calling app through
# `createRuntime()` / `createCoreConfig()`. That is what makes the domain layer
# testable without a process environment and reusable from a job runner.
#
# The one exception is tests, which are not domain code:

# Opt-in. Set it and the integration tests run against it; leave it unset and
# they skip, which is what keeps `pnpm test` green on a fresh clone.
# Point it at a THROWAWAY database — the suite migrates and truncates.
TEST_DATABASE_URL=
