# @koolee/db — used ONLY by the drizzle-kit CLI and the seed script.
# Apps pass their own env at runtime; this package reads nothing in production.
#
# Copy to `.env` (NOT `.env.local` — drizzle-kit's convention, and what
# drizzle.config.ts loads).
#
# `pnpm db:generate` needs NOTHING; it diffs the schema offline.
# `pnpm db:migrate` and `pnpm db:studio` use DIRECT_DATABASE_URL (port 5432).
# `pnpm seed` uses DATABASE_URL.
#
# Never point DIRECT_DATABASE_URL at the Supavisor pooler — the migrator takes
# an advisory lock and issues DDL, which transaction pooling cannot support.

# Supabase → Connect → Database. Pooled, TRANSACTION mode, port 6543.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Supabase → Connect → Database. Direct connection, port 5432.
DIRECT_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Local Postgres instead (docker compose up -d) — matches docker-compose.yml:
# DATABASE_URL=postgres://koolee:koolee@localhost:5433/koolee
# DIRECT_DATABASE_URL=postgres://koolee:koolee@localhost:5433/koolee
